{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_ROOT__/.claude/hooks/project-restore.sh",
            "timeout": 10,
            "statusMessage": "Restoring project context..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "mcp__playwright__*",
      "mcp__context7__*",
      "mcp__local-rag__*"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(*git push*)",
      "Bash(gh:*)",
      "Bash(gh *)",
      "Bash(*gh *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)"
    ]
  }
}
