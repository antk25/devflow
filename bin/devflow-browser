#!/usr/bin/env bash
# devflow-browser — chrome-devtools CLI (chrome-devtools-mcp) in an isolated, headless, per-run session.
# Secrets are referenced as @env:NAME, substituted here from browser.env and masked in the output,
# so neither the calling agent nor a saved script ever sees a value.
#   devflow-browser start [--insecure]      → prints the session id
#   devflow-browser <id> <tool> [args…]     → chrome-devtools <tool> args… --sessionId <id>
#   devflow-browser <id> stop
set -euo pipefail

PACKAGE=chrome-devtools-mcp@1.10.1
SMOKE_DIR="${DEVFLOW_SMOKE_DIR:-/tmp/devflow-smoke}"
ENV_FILE="${DEVFLOW_BROWSER_ENV:-$HOME/.config/devflow/browser.env}"
SESSIONS_DIR="$SMOKE_DIR/.sessions"
# Flags that would attach to another browser or a shared profile.
FORBIDDEN=' start --sessionId --userDataDir --isolated --browserUrl -u --wsEndpoint --autoConnect '

refuse() {
  echo "devflow-browser: $1" >&2
  exit "$2"
}

declare -A SECRETS=()
load_env() {
  [[ -f "$ENV_FILE" ]] || return 0
  local line name value
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    [[ "$line" =~ ^[[:space:]]*([A-Z_][A-Z0-9_]*)=(.*)$ ]] || continue
    name=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
    SECRETS[$name]=$value
  done < "$ENV_FILE"
}

substitute() {
  local arg=$1 name
  while [[ "$arg" =~ @env:([A-Z_][A-Z0-9_]*) ]]; do
    name=${BASH_REMATCH[1]}
    [[ -f "$ENV_FILE" ]] || refuse "@env:$name requested but $ENV_FILE does not exist." 4
    [[ -v SECRETS[$name] ]] || refuse "@env:$name is not defined in $ENV_FILE." 4
    arg=${arg//"@env:$name"/"${SECRETS[$name]}"}
  done
  printf '%s' "$arg"
}

mask() {
  local text=$1 value
  for value in "${SECRETS[@]}"; do
    [[ -n "$value" ]] && text=${text//"$value"/***}
  done
  printf '%s' "$text"
}

run_cli() {
  local out err rc=0
  out=$(mktemp) err=$(mktemp)
  npx -y -p "$PACKAGE" chrome-devtools "$@" >"$out" 2>"$err" || rc=$?
  mask "$(cat "$out")" ; [[ -s "$out" ]] && echo
  mask "$(cat "$err")" >&2; [[ -s "$err" ]] && echo >&2
  rm -f "$out" "$err"
  return $rc
}

load_env

(( $# >= 1 )) || refuse "usage: devflow-browser start [--insecure] | devflow-browser <id> <tool> [args…] | devflow-browser <id> stop" 2

if [[ "$1" == start ]]; then
  shift
  extra=()
  for arg in "$@"; do
    case "$arg" in
      --insecure) extra+=(--acceptInsecureCerts) ;;
      *) refuse "start accepts only --insecure, got '$arg'." 2 ;;
    esac
  done
  id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)
  mkdir -p "$SESSIONS_DIR"
  run_cli start --isolated --headless --redactNetworkHeaders "${extra[@]}" --sessionId "$id" >&2
  : > "$SESSIONS_DIR/$id"
  echo "$id"
  exit 0
fi

id=$1; shift
[[ "$id" =~ ^[0-9a-f-]+$ ]] || refuse "'$id' is not a session id — run 'devflow-browser start' first." 2
(( $# >= 1 )) || refuse "tool name missing: devflow-browser <id> <tool> [args…]" 2

if [[ "$1" == stop ]]; then
  [[ -f "$SESSIONS_DIR/$id" ]] || exit 0
  rc=0
  run_cli stop --sessionId "$id" || rc=$?
  rm -f "$SESSIONS_DIR/$id"
  exit $rc
fi

[[ -f "$SESSIONS_DIR/$id" ]] || refuse "no session '$id' — run 'devflow-browser start' first." 3

args=()
for arg in "$@"; do
  name=${arg%%=*}
  [[ "$FORBIDDEN" != *" $arg "* && "$FORBIDDEN" != *" $name "* ]] || refuse "refused '$arg' — it would attach to another browser or a shared profile." 2
  args+=("$(substitute "$arg")")
done

run_cli "${args[@]}" --sessionId "$id"
