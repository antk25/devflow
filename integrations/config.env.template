# Аккаунты Jira Cloud. Токен: https://id.atlassian.com/manage-profile/security/api-tokens
# Имя аккаунта в переменных — верхним регистром. PROJECTS — ключи проектов через пробел;
# задача с чужим ключом уходит в JIRA_DEFAULT_ACCOUNT.
JIRA_ACCOUNTS="resolventa productsearch"
JIRA_DEFAULT_ACCOUNT=resolventa

JIRA_RESOLVENTA_BASE_URL=https://your-company.atlassian.net
JIRA_RESOLVENTA_EMAIL=user@company.com
JIRA_RESOLVENTA_API_TOKEN=
JIRA_RESOLVENTA_PROJECTS=""

JIRA_PRODUCTSEARCH_BASE_URL=https://other-company.atlassian.net
JIRA_PRODUCTSEARCH_EMAIL=user@company.com
JIRA_PRODUCTSEARCH_API_TOKEN=
JIRA_PRODUCTSEARCH_PROJECTS="SE"

# Yandex Tracker API
# Get token: https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_APP_ID
# Or use IAM token
YANDEX_TRACKER_BASE_URL=https://api.tracker.yandex.net
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_TOKEN=
